  componentType TourComponentType @map("component_type")
  pricingMethod TourPricingMethod @map("pricing_method")
  unitPrice     Decimal           @map("unit_price") @db.Decimal(10, 2)
  quantity      Int               @default(1)
  totalPrice    Decimal           @map("total_price") @db.Decimal(10, 2)
  description   String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  booking HeritageTourBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, componentType])
  @@map("heritage_tour_booking_price_items")
}

