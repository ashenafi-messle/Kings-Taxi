// ==============================================================================
// 45. Admin User Entity (Authoritative Super Admin & Management Accounts)
// ==============================================================================

model AdminUser {
  id                 String        @id @default(uuid()) @db.Uuid
  fullName           String        @map("full_name") @db.VarChar(128)
  email              String        @unique @db.VarChar(255)
  phoneNumber        String?       @map("phone_number") @db.VarChar(32)
  passwordHash       String        @map("password_hash") @db.VarChar(255)
  passwordSalt       String?       @map("password_salt") @db.VarChar(64)
  role               UserRoleType  @default(SUPER_ADMIN)
  avatarUrl          String?       @map("avatar_url") @db.Text
  department         String?       @db.VarChar(128)
  accountStatus      AccountStatus @default(ACTIVE) @map("account_status")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens      RefreshToken[]
  passwordResets     AdminPasswordReset[]

  @@index([email])
  @@index([role, accountStatus])
  @@map("admin_users")
}

// ==============================================================================
// 46. Admin Password Reset Entity (Email OTP & Cryptographic Tokens)
// ==============================================================================

model AdminPasswordReset {
  id                  String    @id @default(uuid()) @db.Uuid
  adminUserId         String    @map("admin_user_id") @db.Uuid
  email               String    @db.VarChar(255)
  otpHash             String    @map("otp_hash") @db.VarChar(255)
  salt                String    @db.VarChar(128)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5) @map("max_attempts")
  resendCooldownUntil DateTime  @map("resend_cooldown_until") @db.Timestamptz(6)
  isVerified          Boolean   @default(false) @map("is_verified")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  resetTokenHash      String?   @map("reset_token_hash") @db.VarChar(255)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(6)
  isConsumed          Boolean   @default(false) @map("is_consumed")
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipAddress           String?   @map("ip_address") @db.VarChar(45)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([email])
  @@index([resetTokenHash])
  @@index([expiresAt])
  @@map("admin_password_resets")
}

// ==============================================================================
// 47. Vehicle Driver Assignment History Entity
// ==============================================================================

model VehicleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  driverId     String    @map("driver_id") @db.Uuid
  assignedBy   String?   @map("assigned_by") @db.VarChar(128)
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedBy String?   @map("unassigned_by") @db.VarChar(128)
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  notes        String?   @db.Text

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([vehicleId, isActive])
  @@index([driverId, isActive])
  @@index([assignedAt])
  @@map("vehicle_assignments")
}

