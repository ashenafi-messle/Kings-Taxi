// ==============================================================================
// 19. Hotel Entity
// ==============================================================================

model Hotel {
  id                 String                  @id @default(uuid()) @db.Uuid
  partnerId          String?                 @map("partner_id") @db.Uuid
  name               String                  @db.VarChar(128)
  slug               String                  @unique @db.VarChar(128)
