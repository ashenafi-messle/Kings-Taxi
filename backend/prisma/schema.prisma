// ==============================================================================
// Kings Taxi Central Backend — Database Schema (PostgreSQL + Prisma)
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum PassengerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum SupportedLanguage {
  EN
  AM
  TI
  OR
}

enum AuthProvider {
  EMAIL
  TELEGRAM
  PHONE
}

enum OtpChannel {
  EMAIL
  TELEGRAM
  SMS
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  IDENTITY_VERIFICATION
  CHANGE_PHONE
  CHANGE_EMAIL
}

enum ClientPlatform {
  ANDROID
  IOS
  WEB
  UNKNOWN
}

enum BookingServiceType {
  RIDE_HAILING
  HOTEL_TRANSPORT
  HERITAGE_TOUR
  FULL_CONTRACT
}

enum BookingStatus {
  DRAFT
  REQUESTED
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  CANCELLED
}

enum CancellationActor {
  PASSENGER
  DRIVER
  SYSTEM
  ADMIN
}

// ------------------------------------------------------------------------------
// Core Passenger & Authentication Entities
// ------------------------------------------------------------------------------

model Passenger {
  id           String          @id @default(uuid()) @db.Uuid
  phone        String?         @unique @db.VarChar(32)
  email        String?         @unique @db.VarChar(255)
  status       PassengerStatus @default(PENDING_VERIFICATION)
  passwordHash String          @db.VarChar(255)
  passwordSalt String?         @db.VarChar(128)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  profile          PassengerProfile?
  authIdentities   PassengerAuthIdentity[]
  sessions         PassengerSession[]
  refreshTokens    RefreshToken[]
  otpVerifications OTPVerification[]
  bookings         Booking[]
  auditLogs        AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("passengers")
}

model PassengerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  passengerId String   @unique @map("passenger_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(128)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(512)
  language    SupportedLanguage @default(EN) @map("preferred_language")
  city        String   @default("Gondar") @db.VarChar(64)

  emergencyContactName  String? @map("emergency_contact_name") @db.VarChar(128)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@map("passenger_profiles")
}

model PassengerAuthIdentity {
  id          String       @id @default(uuid()) @db.Uuid
  passengerId String       @map("passenger_id") @db.Uuid
  provider    AuthProvider
  providerId  String       @map("provider_id") @db.VarChar(255)
  verified    Boolean      @default(false)
  verifiedAt  DateTime?    @map("verified_at") @db.Timestamptz(6)
  metadata    Json?        @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([passengerId])
  @@map("passenger_auth_identities")
}

model OTPVerification {
  id                  String     @id @default(uuid()) @db.Uuid
  identifier          String     @db.VarChar(255)
  purpose             OtpPurpose
  channel             OtpChannel
  codeHash            String     @map("code_hash") @db.VarChar(255)
  salt                String     @db.VarChar(128)
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts            Int        @default(0)
  maxAttempts         Int        @default(3) @map("max_attempts")
  resendCooldownUntil DateTime   @map("resend_cooldown_until") @db.Timestamptz(6)
  isConsumed          Boolean    @default(false) @map("is_consumed")
  consumedAt          DateTime?  @map("consumed_at") @db.Timestamptz(6)

  passengerId String? @map("passenger_id") @db.Uuid
  ipAddress   String? @map("ip_address") @db.VarChar(45)
  userAgent   String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  passenger Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)

  @@index([identifier, purpose, isConsumed])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  passengerId         String    @map("passenger_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(255)
  familyId            String    @map("family_id") @db.VarChar(64)
  sessionId           String?   @map("session_id") @db.Uuid
  isRevoked           Boolean   @default(false) @map("is_revoked")
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenHash String?   @map("replaced_by_token_hash") @db.VarChar(255)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([passengerId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PassengerSession {
  id          String         @id @default(uuid()) @db.Uuid
  passengerId String         @map("passenger_id") @db.Uuid
  deviceId    String?        @map("device_id") @db.VarChar(128)
  deviceName  String?        @map("device_name") @db.VarChar(128)
  platform    ClientPlatform @default(UNKNOWN)
  appVersion  String?        @map("app_version") @db.VarChar(32)
  ipAddress   String?        @map("ip_address") @db.VarChar(45)
  userAgent   String?        @map("user_agent") @db.VarChar(512)
  isActive    Boolean        @default(true) @map("is_active")
  lastActiveAt DateTime      @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([passengerId, isActive])
  @@map("passenger_sessions")
}

// ------------------------------------------------------------------------------
// Transportation & Booking Domain (Future-Compatible Foundation)
// ------------------------------------------------------------------------------

model Booking {
  id               String             @id @default(uuid()) @db.Uuid
  bookingReference String             @unique @map("booking_reference") @db.VarChar(32)
  passengerId      String             @map("passenger_id") @db.Uuid
  driverId         String?            @map("driver_id") @db.Uuid
  vehicleId        String?            @map("vehicle_id") @db.Uuid
  serviceType      BookingServiceType @default(RIDE_HAILING) @map("service_type")
  status           BookingStatus      @default(DRAFT)

  pickupAddress   String @map("pickup_address") @db.VarChar(255)
  pickupLatitude  Float  @map("pickup_latitude")
  pickupLongitude Float  @map("pickup_longitude")

  dropoffAddress   String @map("dropoff_address") @db.VarChar(255)
  dropoffLatitude  Float  @map("dropoff_latitude")
  dropoffLongitude Float  @map("dropoff_longitude")

  estimatedDistanceMeters  Int?     @map("estimated_distance_meters")
  estimatedDurationSeconds Int?     @map("estimated_duration_seconds")
  estimatedFare            Decimal? @map("estimated_fare") @db.Decimal(10, 2)
  finalFare                Decimal? @map("final_fare") @db.Decimal(10, 2)
  currency                 String   @default("ETB") @db.VarChar(8)

  cancellationReason String?            @map("cancellation_reason") @db.VarChar(255)
  cancelledBy        CancellationActor? @map("cancelled_by")

  passengerRating   Int?    @map("passenger_rating") @db.SmallInt
  passengerFeedback String? @map("passenger_feedback") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Restrict)

  @@index([passengerId, status])
  @@index([bookingReference])
  @@index([createdAt])
  @@map("bookings")
}

// ------------------------------------------------------------------------------
// Security & System Audit Logs
// ------------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String   @map("entity_id") @db.VarChar(64)
  action      String   @db.VarChar(64)
  performedBy String?  @map("performed_by") @db.VarChar(64)
  passengerId String?  @map("passenger_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  passenger Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

