NODE_ENV=test
PORT=3001
API_PREFIX=/api/v1
LOG_LEVEL=silent
DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/kings_taxi_test?schema=public
JWT_ACCESS_SECRET=test_access_secret_must_be_at_least_32_characters_long_for_security
JWT_REFRESH_SECRET=test_refresh_secret_must_be_at_least_32_characters_long_for_security
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

