# ==============================================================================
# Kings Taxi Central Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files containing real secrets to version control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# PostgreSQL Database (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://kings_user:kings_secure_password_2026@localhost:5432/kings_taxi_db?schema=public

# Authentication & JWT Security (Argon2id + Rotating JWTs)
JWT_ACCESS_SECRET=replace_with_64_byte_random_cryptographic_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_cryptographic_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Allowed Origins (Comma-separated for multiple hosts)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,exp://localhost:8081,https://taxi-api.erkabskill.com,https://api.kingstaxi.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================================================================
# Future External Integrations (Placeholders for Subsequent Phases)
# ==============================================================================

# Telegram Official Bot Verification (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KingsTaxiAuthBot

# Transactional Email Service (Phase 2 - SMTP / Resend / AWS SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@kingstaxi.et
EMAIL_FROM_NAME="Kings Taxi Ethiopia"

# Payment Gateways (Phase 5 - Telebirr, CBE Birr, Chapa)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=

# Geolocation & Maps (Gondar Route Optimization & Geocoding)
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Push Notifications (Firebase Cloud Messaging / Expo Push)
EXPO_ACCESS_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=

