# ==============================================================================
# Kings Taxi Central Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files containing real secrets to version control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# PostgreSQL Database (Prisma ORM)
# Local development connects securely via SSH tunnel to kings_taxi_dev on Zergaw VPS:
# SSH Tunnel Command: ssh -N -L 5433:172.18.0.7:5432 ambelu@196.188.250.186
DATABASE_URL="postgresql://kings_taxi_dev_user:YOUR_PASSWORD@127.0.0.1:5433/kings_taxi_dev?schema=public"

# Authentication & JWT Security (Argon2id + Rotating JWTs)
JWT_ACCESS_SECRET=replace_with_64_byte_random_cryptographic_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_cryptographic_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Allowed Origins (Comma-separated for multiple hosts)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,exp://localhost:8081,https://taxi-api.erkabskill.com,https://api.kingstaxi.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================================================================
# Future External Integrations (Placeholders for Subsequent Phases)
# ==============================================================================

# Telegram Official Bot Verification (Phase 2)
# Create bot via @BotFather, get token and username:
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=KingstaxiBot
TELEGRAM_BOT_LINK=https://t.me/KingstaxiBot
TELEGRAM_WEBHOOK_SECRET=your_secret_token_here
TELEGRAM_WEBHOOK_URL=https://api.kingstaxi.et/api/v1/auth/telegram/webhook

# Transactional Email Service (Brevo SMTP / Port 587 STARTTLS)
# Brevo credentials available at: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="Kings Taxi <ashenafimesele78@gmail.com>"
EMAIL_FROM_ADDRESS=ashenafimesele78@gmail.com
EMAIL_FROM_NAME="Kings Taxi Ethiopia"

# Payment Gateways (Phase 5 - Telebirr, CBE Birr, Chapa)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=

# Geolocation & Maps (Gondar Route Optimization & Geocoding)
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Push Notifications (Firebase Cloud Messaging / Expo Push)
EXPO_ACCESS_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=

