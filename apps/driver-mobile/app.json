{
  "expo": {
    "name": "Kings Taxi Driver",
    "slug": "kings-taxi-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kingstaxidriver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F5F6F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "et.kingstaxi.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kings Taxi Driver uses your foreground location to display your position on the active trip map."
      }
    },
    "android": {
      "package": "et.kingstaxi.driver",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F7"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kings Taxi Driver to access your location while using the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
