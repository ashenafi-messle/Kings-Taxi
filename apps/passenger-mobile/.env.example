# Kings Taxi Passenger Mobile Environment Configuration
# ==============================================================================
# Production Render Backend Configuration (Default for releases & staging)
# ==============================================================================
EXPO_PUBLIC_APP_NAME="Kings Taxi"
EXPO_PUBLIC_ENVIRONMENT="production"
EXPO_PUBLIC_DATA_SOURCE="real"
EXPO_PUBLIC_API_URL="https://kings-taxi.onrender.com/api/v1"
EXPO_PUBLIC_SOCKET_URL="https://kings-taxi.onrender.com"
EXPO_PUBLIC_DEFAULT_CURRENCY="ETB"

# ==============================================================================
# Local Development Backend Alternatives
# (Uncomment below to target a locally running backend instead of Render)
# ==============================================================================
# EXPO_PUBLIC_ENVIRONMENT="development"
# EXPO_PUBLIC_DATA_SOURCE="real"
# EXPO_PUBLIC_API_URL="http://10.0.2.2:5000/api/v1"     # Android Emulator loopback
# EXPO_PUBLIC_API_URL="http://127.0.0.1:5000/api/v1"    # iOS Simulator / Web localhost
# EXPO_PUBLIC_SOCKET_URL="http://127.0.0.1:5000"
