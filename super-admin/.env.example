# Kings Taxi Super Admin Portal Environment Configuration

# Next.js Port and Base URL
PORT=3000
NEXT_PUBLIC_APP_NAME="Kings Taxi Super Admin"
NEXT_PUBLIC_APP_ENV="development"

# Central Backend API Endpoint (Kings Taxi Central Backend)
NEXT_PUBLIC_API_URL="https://kings-taxi.onrender.com/api/v1"
NEXT_PUBLIC_LOCAL_API_URL="http://127.0.0.1:5000/api/v1"

# Real-time WebSocket Gateway
NEXT_PUBLIC_SOCKET_URL="https://kings-taxi.onrender.com"

# Demonstration and Mock Controls
NEXT_PUBLIC_USE_MOCK_DATA="true"
NEXT_PUBLIC_SIMULATE_GPS="true"

# Default Currency
NEXT_PUBLIC_DEFAULT_CURRENCY="ETB"
