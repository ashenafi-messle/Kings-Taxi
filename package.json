{
  "name": "kings-taxi-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Kings Taxi Mobile & Mobility Services Platform",
  "workspaces": [
    "apps/passenger-mobile",
    "backend",
    "shared"
  ],
  "scripts": {
    "start": "npm run start --prefix apps/passenger-mobile",
    "android": "npm run android --prefix apps/passenger-mobile",
    "ios": "npm run ios --prefix apps/passenger-mobile",
    "web": "npm run web --prefix apps/passenger-mobile",
    "typecheck": "npm run typecheck --prefix apps/passenger-mobile",
    "backend:dev": "npm run dev --prefix backend",
    "backend:build": "npm run build --prefix backend",
    "backend:test": "npm run test --prefix backend",
    "backend:lint": "npm run lint --prefix backend",
    "audit:i18n": "node scripts/audit-translations.js",
    "test:i18n": "node scripts/test-multilingual-runtime.js",
    "build:android": "cd apps/passenger-mobile && eas build --platform android --profile preview",
    "build:ios": "cd apps/passenger-mobile && eas build --platform ios --profile preview",
    "build:production": "cd apps/passenger-mobile && eas build --platform all --profile production"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "overrides": {
    "react-native-svg": "15.8.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo-localization": "~16.0.1",
    "i18next": "^26.7.2",
    "query-string": "^7.1.3",
    "react-i18next": "^17.1.13",
    "react-native-svg": "15.8.0"
  }
}
